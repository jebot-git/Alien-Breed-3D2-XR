# This child's preloaded test runtime never contacts a physical headset.
file(MAKE_DIRECTORY "${OUTPUT}")
file(WRITE "${OUTPUT}/eyes" "")
set(extra)
if(MODE STREQUAL "gl-minimum")
 # NVIDIA may return exactly the requested 3.3 context; a runtime can need 4.5.
 list(APPEND extra DE_XR_TEST_GL_MIN=4.5 DE_XR_TEST_PREPARE_GL=1)
elseif(MODE STREQUAL "gl-newer")
 list(APPEND extra DE_XR_TEST_GL_MAX=3.3 DE_XR_TEST_PREPARE_GL=1)
elseif(MODE STREQUAL "gl-unavailable")
 list(APPEND extra DE_XR_TEST_GL_MIN=9.9 DE_XR_TEST_GL_MAX=9.9 DE_XR_TEST_PREPARE_GL=1)
elseif(MODE STREQUAL "menu")
 list(APPEND extra ABXR_TEST_MENU=1)
 file(MAKE_DIRECTORY "${OUTPUT}/state/alien-breed3d2-xr")
 file(WRITE "${OUTPUT}/state/alien-breed3d2-xr/slot1.ab2xr" "")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
 "LD_PRELOAD=${MOCK}" SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy ${extra}
 "ABXR_TEST_EYES=${OUTPUT}/eyes" ABXR_TEST_EYE_SIZE=512
 "XDG_STATE_HOME=${OUTPUT}/state" "XDG_CONFIG_HOME=${OUTPUT}/config"
 "${APP}" --xr --standalone --test-play --assets "${ASSETS}" --frames 180 --report "${OUTPUT}/report.json"
 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(MODE STREQUAL "gl-unavailable")
 if(NOT status EQUAL 1 OR NOT errors MATCHES "Cannot create OpenGL 9.9")
  message(FATAL_ERROR "Expected clear context creation failure: ${status} ${errors}")
 endif()
 return()
endif()
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Isolated XR failed (${status}): ${output}\n${errors}")
endif()
file(READ "${OUTPUT}/report.json" report)
foreach(key frames eye_frames pal_ticks missing_assets audio_buffers audio_queue_failures)
 string(JSON ${key} GET "${report}" ${key})
endforeach()
if(NOT frames EQUAL 180 OR NOT eye_frames EQUAL 360 OR missing_assets GREATER 0 OR audio_queue_failures GREATER 0 OR audio_buffers LESS 1)
 message(FATAL_ERROR "Incomplete native XR/audio: ${report}")
endif()
if(NOT MODE STREQUAL "menu" AND (pal_ticks LESS 90 OR pal_ticks GREATER 140))
 message(FATAL_ERROR "PAL timing not independent of90Hz presentation: ${report}")
endif()
file(STRINGS "${OUTPUT}/eyes" eyes)
list(LENGTH eyes length)
if(NOT length EQUAL 180)
 message(FATAL_ERROR "Missing stereo frame records")
endif()
foreach(pair IN LISTS eyes)
 string(REPLACE " " ";" parts "${pair}")
 list(GET parts 1 left)
 list(GET parts 2 right)
 if(left STREQUAL right)
  message(FATAL_ERROR "Identical eye images: ${pair}")
 endif()
endforeach()
message(STATUS "PASS native XR180frames/360eyes, ${pal_ticks} PAL ticks, ${audio_buffers} Paula buffers, stereo parallax, no missing art or audio queue failures")

if(MODE STREQUAL "menu")
 file(SIZE "${OUTPUT}/state/alien-breed3d2-xr/slot1.ab2xr" save_size)
 if(save_size LESS 1000)
  message(FATAL_ERROR "Controller menu did not save a game")
 endif()
endif()

if(MODE STREQUAL "gl-minimum" AND NOT errors MATCHES "runtime minimum 4.5")
 message(FATAL_ERROR "Missing GL minimum diagnostics: ${errors}")
elseif(MODE STREQUAL "gl-newer" AND NOT errors MATCHES "trying the compatible context")
 message(FATAL_ERROR "Missing newer GL diagnostics: ${errors}")
endif()
